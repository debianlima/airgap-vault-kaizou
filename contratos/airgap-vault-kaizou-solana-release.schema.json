{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "airgap-vault-kaizou-solana-release.schema.json",
  "title": "AirGap Vault Kaizou Solana release contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release",
    "module",
    "stake",
    "homologation"
  ],
  "properties": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "developmentMode",
        "releaseMode",
        "staticAssetPath",
        "requiredFiles",
        "verifySignature"
      ],
      "properties": {
        "developmentMode": {
          "const": "external-project"
        },
        "releaseMode": {
          "const": "static-asset-module"
        },
        "staticAssetPath": {
          "const": "public/assets/protocol_modules/airgap-solana-module"
        },
        "requiredFiles": {
          "const": [
            "manifest.json",
            "airgap-solana-module.bundle.js",
            "module.sig"
          ]
        },
        "verifySignature": {
          "const": true
        }
      }
    },
    "stake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeInstructionTypes",
        "ignoreForClassification",
        "unknownProgramPolicy"
      ],
      "properties": {
        "nativeInstructionTypes": {
          "type": "array",
          "uniqueItems": true,
          "contains": {
            "const": "Deactivate"
          },
          "items": {
            "enum": [
              "Initialize",
              "Authorize",
              "AuthorizeWithSeed",
              "Delegate",
              "Split",
              "Withdraw",
              "Deactivate",
              "Merge"
            ]
          }
        },
        "ignoreForClassification": {
          "const": [
            "ComputeBudget111111111111111111111111111111"
          ]
        },
        "unknownProgramPolicy": {
          "const": "warn-preserve-bytes-and-allow-valid-signature"
        }
      }
    },
    "homologation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "android",
        "solflare",
        "regression",
        "dynamicQr",
        "solflareSignType",
        "pairingSignerKey",
        "messageSignatureSemantics"
      ],
      "properties": {
        "android": {
          "const": "Android 11 Google Play user non-root: module 0.1.6 available on clean install without ZIP import; stake remains functional and a Keystone-supported liquidity-pool request is classified offline rather than unrecognized"
        },
        "solflare": {
          "const": "sol-sign-request -> Vault -> sol-signature preserves requestId and verifies Ed25519"
        },
        "regression": {
          "const": "full upstream suite plus Kaizou Solflare/stake/liquidity-pool gates and non-Solana isolation gate"
        },
        "dynamicQr": {
          "const": "animated sol-sign-request fountain fragments accumulate until complete; signData may be a Solana message or a complete serialized transaction; complete transactions are preserved byte-for-byte rather than double-prefixed"
        },
        "solflareSignType": {
          "const": "real Solflare dynamic QR may encode SolSignRequest SignType.Message or SignType.Transaction; both must route to transaction signing without Incompatible code"
        },
        "pairingSignerKey": {
          "const": "crypto-multi-accounts and sol-signature signer selection use the Ed25519 public key encoded by the Solana receiving address; stale or divergent wallet.publicKey must not be advertised as the signer"
        },
        "messageSignatureSemantics": {
          "const": "Solflare SignType.Message signData is the serialized Solana transaction message: Vault creates only the required empty signature slots for local signing and preserves message bytes exactly; the Keystone response is the detached Ed25519 sol-signature bound to the original requestId. SignType.Transaction may instead preserve a complete serialized transaction byte-for-byte."
        },
        "signingSimulationMatrix": {
          "const": {
            "minimumCases": 30,
            "repetitions": 6,
            "discardFirstTiming": true,
            "metrics": [
              "semantic_pass_rate",
              "message_byte_equality",
              "multisigner_preservation",
              "expected_rejection_stability",
              "latency_ms"
            ],
            "thresholds": {
              "semanticPassRate": 1.0,
              "unexpectedMutationCount": 0,
              "unexpectedAcceptanceCount": 0,
              "unexpectedRejectionCount": 0
            },
            "report": [
              "median_latency_ms",
              "mad_latency_ms",
              "case_count",
              "pass_count",
              "expected_rejection_count"
            ],
            "environment": "WSL Node 24, exact airgap-solana-module 0.1.6 source/bundle, deterministic synthetic keys; no RPC submission",
            "sources": [
              "Solana official transaction rules",
              "Anza wallet-adapter ca731858affa36fa91b593cc670747b671c4589f",
              "Solana Stack Exchange failure shapes"
            ],
            "measuredRepetitions": 5
          }
        },
        "captureResilienceSimulation": {
          "const": {
            "minimumBanks": 4,
            "minimumScenarios": 24,
            "repetitions": 6,
            "measuredRepetitions": 5,
            "discardFirstTiming": true,
            "candidateSequence": [
              "normalize",
              "recognize-type",
              "parse-fountain-metadata",
              "discard-invalid-frame",
              "deduplicate",
              "route-by-type-seqLen-messageLen-checksum",
              "decode-per-stream",
              "validate-complete-UR",
              "emit-once"
            ],
            "variations": [
              "ordered",
              "reverse",
              "shuffle",
              "duplicate",
              "burst-duplicate",
              "drop-recoverable",
              "corrupt",
              "truncate",
              "noise",
              "whitespace",
              "case",
              "partial-cycle-then-full",
              "interleaved-stream",
              "stale-stream",
              "long-gap"
            ],
            "thresholds": {
              "recoverableTargetSuccessRate": 1.0,
              "falseSuccessCount": 0,
              "unhandledExceptionCount": 0,
              "maxActiveStreams": 4
            },
            "report": [
              "baseline_success_rate",
              "candidate_success_rate",
              "candidate_false_success_count",
              "candidate_unhandled_exception_count",
              "candidate_max_active_streams",
              "median_latency_ms",
              "mad_latency_ms"
            ],
            "privacy": "versioned evidence contains no real user transaction payload; private capture may be checked transiently only"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kaizouVersion",
        "tag",
        "solanaModuleVersion",
        "solanaModuleProject",
        "moduleEvolvesIndependently"
      ],
      "properties": {
        "kaizouVersion": {
          "const": "1.1.2"
        },
        "tag": {
          "const": "airgap-vault-kaizou-1.1.2"
        },
        "solanaModuleVersion": {
          "const": "0.1.6"
        },
        "solanaModuleProject": {
          "const": "airgap-solana-module"
        },
        "moduleEvolvesIndependently": {
          "const": true
        }
      }
    }
  }
}
